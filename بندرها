<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0d0f14;
  --bg2: #13161e;
  --bg3: #1a1e2a;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --text: #e8eaf0;
  --text2: #8b90a0;
  --text3: #555b6e;
  --accent: #4f8ef7;
  --accent2: #2563eb;
  --green: #22c55e;
  --green-bg: rgba(34,197,94,0.1);
  --amber: #f59e0b;
  --amber-bg: rgba(245,158,11,0.1);
  --red: #ef4444;
  --red-bg: rgba(239,68,68,0.1);
  --blue-bg: rgba(79,142,247,0.1);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Vazirmatn',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;font-size:14px;line-height:1.6}
::selection{background:rgba(79,142,247,0.3)}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--bg3);border-radius:3px}

.header{background:var(--bg2);border-bottom:1px solid var(--border);padding:20px 32px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:100;backdrop-filter:blur(12px)}
.header-logo{width:36px;height:36px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:#fff;flex-shrink:0}
.header-title{font-size:17px;font-weight:600;color:var(--text)}
.header-sub{font-size:12px;color:var(--text2);margin-top:1px}
.header-badge{margin-right:auto;background:var(--green-bg);color:var(--green);font-size:11px;padding:4px 12px;border-radius:20px;border:1px solid rgba(34,197,94,0.2);font-weight:500}

.main{padding:24px 32px;max-width:1400px;margin:0 auto}

.alert{display:flex;gap:10px;align-items:flex-start;padding:12px 16px;border-radius:10px;margin-bottom:12px;font-size:13px;line-height:1.5}
.alert-danger{background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);color:#fca5a5}
.alert-warn{background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);color:#fcd34d}
.alert-icon{font-size:16px;flex-shrink:0;margin-top:1px}

.section-label{font-size:11px;font-weight:600;color:var(--text3);letter-spacing:.1em;text-transform:uppercase;margin:28px 0 12px}

.filter-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.filter-btn{font-size:12px;padding:6px 16px;border-radius:20px;border:1px solid var(--border2);background:transparent;cursor:pointer;color:var(--text2);transition:all .15s;font-family:'Vazirmatn',sans-serif}
.filter-btn:hover{border-color:var(--accent);color:var(--accent)}
.filter-btn.on{background:var(--blue-bg);border-color:var(--accent);color:var(--accent)}

.port-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-bottom:8px}

.pcard{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:16px;cursor:pointer;transition:all .15s;position:relative;overflow:hidden}
.pcard::before{content:'';position:absolute;top:0;right:0;width:3px;height:100%;background:var(--score-color,var(--border));border-radius:0 12px 12px 0;opacity:0;transition:opacity .15s}
.pcard:hover{border-color:var(--border2);transform:translateY(-1px)}
.pcard:hover::before{opacity:1}
.pcard.active{border-color:var(--accent);background:var(--bg3)}
.pcard.active::before{opacity:1;background:var(--accent)}

.pcard-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.pcard-name{font-size:13px;font-weight:600;color:var(--text);line-height:1.3}
.pcard-country{font-size:11px;color:var(--text2);margin-top:2px}
.score{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;flex-shrink:0;border:2px solid}

.score-green{color:var(--green);border-color:rgba(34,197,94,0.3);background:var(--green-bg)}
.score-amber{color:var(--amber);border-color:rgba(245,158,11,0.3);background:var(--amber-bg)}
.score-red{color:var(--red);border-color:rgba(239,68,68,0.3);background:var(--red-bg)}

.pcard-rows{display:flex;flex-direction:column;gap:5px}
.pcard-row{display:flex;justify-content:space-between;align-items:center;font-size:11px}
.pcard-row-label{color:var(--text3)}
.pcard-row-val{color:var(--text2);font-weight:500;text-align:left;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fatf-tag{font-size:10px;padding:2px 8px;border-radius:10px;font-weight:600}
.fatf-clean{background:var(--green-bg);color:var(--green);border:1px solid rgba(34,197,94,0.2)}
.fatf-grey{background:var(--amber-bg);color:var(--amber);border:1px solid rgba(245,158,11,0.2)}
.fatf-watch{background:var(--blue-bg);color:var(--accent);border:1px solid rgba(79,142,247,0.2)}

.detail{background:var(--bg2);border:1px solid var(--border2);border-radius:14px;padding:24px;margin-bottom:24px;display:none;animation:fadeIn .2s ease}
.detail.visible{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}

.detail-header{display:flex;align-items:center;gap:12px;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--border)}
.detail-title{font-size:18px;font-weight:700;color:var(--text)}
.detail-country-badge{font-size:12px;padding:4px 12px;border-radius:20px;background:var(--bg3);border:1px solid var(--border2);color:var(--text2)}

.stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:20px}
.stat-box{background:var(--bg3);border-radius:10px;padding:12px 14px}
.stat-label{font-size:11px;color:var(--text3);margin-bottom:4px}
.stat-val{font-size:14px;font-weight:600;color:var(--text)}

.detail-section{margin-bottom:16px}
.detail-section-h{font-size:12px;font-weight:600;color:var(--text2);margin-bottom:8px;display:flex;align-items:center;gap:6px}
.detail-section-h::after{content:'';flex:1;height:1px;background:var(--border)}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{font-size:11px;padding:4px 10px;border-radius:8px;font-weight:500}
.tag-cargo{background:rgba(34,197,94,0.08);color:#86efac;border:1px solid rgba(34,197,94,0.15)}
.tag-doc{background:rgba(79,142,247,0.08);color:#93c5fd;border:1px solid rgba(79,142,247,0.15)}
.tag-risk{background:rgba(239,68,68,0.08);color:#fca5a5;border:1px solid rgba(239,68,68,0.15)}
.tag-fac{background:var(--bg3);color:var(--text2);border:1px solid var(--border)}

.note-box{background:var(--bg3);border-radius:10px;padding:14px 16px;border-right:3px solid var(--accent);font-size:13px;color:var(--text2);line-height:1.7;margin-top:16px}

.divider{height:1px;background:var(--border);margin:32px 0}

.routes-grid{display:grid;gap:16px}
.route-card{background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:20px}
.route-title{font-size:15px;font-weight:700;color:var(--text);margin-bottom:14px}
.route-path{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:16px;padding:12px;background:var(--bg3);border-radius:10px}
.route-node{background:var(--bg2);border:1px solid var(--border2);border-radius:6px;padding:4px 12px;font-size:12px;color:var(--text2)}
.route-arrow{color:var(--text3);font-size:12px}

.route-facts{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;margin-bottom:16px}
.rf{background:var(--bg3);border-radius:8px;padding:10px 12px}
.rf-label{font-size:10px;color:var(--text3);margin-bottom:3px}
.rf-val{font-size:13px;font-weight:600;color:var(--text)}

.risks-list{display:flex;flex-direction:column;gap:7px}
.risk-item{display:flex;gap:8px;align-items:flex-start;font-size:12px;color:var(--text2);line-height:1.5}
.risk-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:4px}
.r-high{background:var(--red)}
.r-med{background:var(--amber)}
.r-low{background:var(--green)}

.route-note{background:var(--bg3);border-radius:10px;padding:12px 14px;border-right:3px solid var(--amber);font-size:12px;color:var(--text2);line-height:1.7;margin-top:14px}

.footer{text-align:center;padding:24px 32px;color:var(--text3);font-size:11px;border-top:1px solid var(--border);margin-top:32px;direction:ltr}

.close-btn{margin-right:auto;background:transparent;border:1px solid var(--border2);color:var(--text2);border-radius:8px;padding:4px 12px;font-size:12px;cursor:pointer;font-family:'Vazirmatn',sans-serif;transition:all .15s}
.close-btn:hover{border-color:var(--red);color:var(--red)}
</style>
</head>
