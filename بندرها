let activeFilter = 'all';
let activePort = null;

function filterPorts(f, btn) {
  activeFilter = f;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  renderPorts();
}

function renderPorts() {
  const g = document.getElementById('portGrid');
  g.innerHTML = '';
  const visible = activeFilter === 'all' ? ports : ports.filter(p => p.region === activeFilter);
  visible.forEach(p => {
    const d = document.createElement('div');
    d.className = 'pcard' + (activePort === p.id ? ' active' : '');
    d.style.setProperty('--score-color', p.scoreClass === 'score-green' ? 'var(--green)' : p.scoreClass === 'score-red' ? 'var(--red)' : 'var(--amber)');
    d.onclick = () => selectPort(p.id);
    const fatfLabel = p.fatfClass === 'fatf-clean' ? '✓ پاک' : p.fatfClass === 'fatf-grey' ? '⚠ ریسک بالا' : '◎ زیر نظر';
    d.innerHTML = `
      <div class="pcard-top">
        <div>
          <div class="pcard-name">${p.name}</div>
          <div class="pcard-country">${p.country}</div>
        </div>
        <div class="score ${p.scoreClass}">${p.score}</div>
      </div>
      <div class="pcard-rows">
        <div class="pcard-row"><span class="pcard-row-label">FATF</span><span class="fatf-tag ${p.fatfClass}">${fatfLabel}</span></div>
        <div class="pcard-row"><span class="pcard-row-label">ظرفیت</span><span class="pcard-row-val">${p.capacity.split('·')[0]}</span></div>
        <div class="pcard-row"><span class="pcard-row-label">Draft</span><span class="pcard-row-val">${p.draft}</span></div>
      </div>`;
    g.appendChild(d);
  });
}

function selectPort(id) {
  if (activePort === id) {
    activePort = null;
    document.getElementById('detailPanel').className = 'detail';
    renderPorts(); return;
  }
  activePort = id;
  const p = ports.find(x => x.id === id);
  renderPorts();
  const dp = document.getElementById('detailPanel');
  dp.className = 'detail visible';
  const fatfLabel = p.fatfClass === 'fatf-clean' ? '✓ پاک' : p.fatfClass === 'fatf-grey' ? '⚠ ریسک بالا' : '◎ زیر نظر';
  dp.innerHTML = `
    <div class="detail-header">
      <div class="detail-title">${p.name}</div>
      <span class="detail-country-badge">${p.country}</span>
      <button class="close-btn" onclick="selectPort('${p.id}')">✕ بستن</button>
    </div>
    <div class="stats-grid">
      <div class="stat-box"><div class="stat-label">امتیاز ریسک (۱۰۰=کم‌ریسک)</div><div class="stat-val">${p.score} / ۱۰۰</div></div>
      <div class="stat-box"><div class="stat-label">وضعیت FATF</div><div class="stat-val" style="font-size:12px">${p.fatf}</div></div>
      <div class="stat-box"><div class="stat-label">ظرفیت</div><div class="stat-val" style="font-size:12px">${p.capacity}</div></div>
      <div class="stat-box"><div class="stat-label">آبخور (Draft)</div><div class="stat-val">${p.draft}</div></div>
    </div>
    <div class="detail-section">
      <div class="detail-section-h">🌐 کشورهای عمده فعال</div>
      <div style="font-size:13px;color:var(--text2)">${p.mainTraders}</div>
    </div>
    <div class="detail-section">
      <div class="detail-section-h">📦 کالاهای اصلی</div>
      <div class="tags">${p.goods.map(g=>`<span class="tag tag-cargo">${g}</span>`).join('')}</div>
    </div>
    <div class="detail-section">
      <div class="detail-section-h">📋 مدارک کامپلاینس کلیدی</div>
      <div class="tags">${p.docs.map(d=>`<span class="tag tag-doc">${d}</span>`).join('')}</div>
    </div>
    <div class="detail-section">
      <div class="detail-section-h">⚠ ریسک‌ها و هشدارها</div>
      <div class="tags">${p.risks.map(r=>`<span class="tag tag-risk">${r}</span>`).join('')}</div>
    </div>
    <div class="detail-section">
      <div class="detail-section-h">🏗 امکانات و زیرساخت</div>
      <div class="tags">${p.facilities.map(f=>`<span class="tag tag-fac">${f}</span>`).join('')}</div>
    </div>
    <div class="note-box">${p.note}</div>`;
  dp.scrollIntoView({behavior:'smooth', block:'nearest'});
}

function renderRoutes() {
  const g = document.getElementById('routesGrid');
  g.innerHTML = '';
  routes.forEach(r => {
    const d = document.createElement('div');
    d.className = 'route-card';
    const pathHtml = r.path.map((n,i)=>i<r.path.length-1?`<span class="route-node">${n}</span><span class="route-arrow">←</span>`:`<span class="route-node">${n}</span>`).join('');
    const factsHtml = r.facts.map(f=>`<div class="rf"><div class="rf-label">${f.l}</div><div class="rf-val">${f.v}</div></div>`).join('');
    const riskColors = {high:'r-high',med:'r-med',low:'r-low'};
    const risksHtml = r.risks.map(ri=>`<div class="risk-item"><div class="risk-dot ${riskColors[ri.level]}"></div><div>${ri.text}</div></div>`).join('');
    d.innerHTML = `
      <div class="route-title">🛣 ${r.title}</div>
      <div class="route-path">${pathHtml}</div>
      <div class="route-facts">${factsHtml}</div>
      <div class="detail-section-h" style="margin-bottom:8px">⚠ نکات حیاتی مسیر</div>
      <div class="risks-list" style="margin-bottom:14px">${risksHtml}</div>
      <div class="route-note">${r.note}</div>`;
    g.appendChild(d);
  });
}

renderPorts();
renderRoutes();
</script>
